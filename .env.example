# Keep real credentials in .env, which is ignored by git.
APP_PASSWORD=choose-a-strong-local-login-password
FLASK_SECRET_KEY=generate-a-random-secret
TOKEN_ENCRYPTION_KEY=generate-a-fernet-key

# Supabase PostgreSQL connection. Use a newly rotated database password.
SUPABASE_DB_HOST=db.qjyoowljswpvorkjgtwl.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace-with-new-rotated-database-password
# Alternatively, set SUPABASE_DB_CON_STRING to the Session Pooler URI from Supabase.
# If the password contains reserved URL characters, percent-encode them in the URI.
# SUPABASE_DB_CON_STRING=postgresql://postgres.<project-ref>:<encoded-password>@<pooler-host>:5432/postgres
